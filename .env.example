# Copy to .env.local and fill in from the Supabase project settings.
# .env.local is gitignored. The anon key is safe to ship in the client bundle
# (Row-Level Security is what protects the data); the service_role key is NOT —
# it only ever goes in the Supabase Edge Function environment, never here.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
